# Application
APP_NAME="AI-Powered ALPR Dynamic Toll Prototype"
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173

# PostgreSQL via Docker Compose
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=capstone_alpr
POSTGRES_USER=capstone_user
POSTGRES_PASSWORD=capstone_password
DATABASE_URL=postgresql+psycopg://capstone_user:capstone_password@localhost:5432/capstone_alpr
TEST_DATABASE_URL=postgresql+psycopg://capstone_user:capstone_password@localhost:5433/capstone_alpr_test

# Demo admin seed values. Change before any shared demo.
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=change-me

# ML/OCR configuration
DATASET_ROOT="Malaysian Car Plate Dataset"
YOLO_DATA_CONFIG=ml/configs/car_plate_data.yaml
DETECTOR_CLASS_NAME="car plate"
DETECTION_CONFIDENCE_THRESHOLD=0.50
OCR_CONFIDENCE_THRESHOLD=0.70

# Simulated pricing defaults
BASE_CURRENCY=MYR